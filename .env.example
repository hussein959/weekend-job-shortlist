# Copy to .env for local runs. On GitHub, add these as repository secrets instead.

# Master CV: Google Drive / Google Docs share link ("Anyone with the link can view").
CV_URL=
# Local runs only: a CV file on your machine, OUTSIDE this repo (ignored when CV_URL is set).
CV_PATH=

# LLM backend: "api" (default, any OpenAI-compatible API) or "cli" (local runs only:
# a command-line AI agent already signed in on this machine, so no API key is needed).
LLM_BACKEND=api

# For LLM_BACKEND=api
LLM_API_KEY=
LLM_BASE_URL=

# For LLM_BACKEND=cli: the agent's non-interactive command. {model} is replaced by the
# model below and the prompt is sent on stdin. Disable the agent's tools if it has any.
LLM_CLI_COMMAND=
# Cheap model: always used for screening (and for tailoring if models.tailoring: cheap)
LLM_SCREEN_MODEL=
# Stronger model: used for tailoring if models.tailoring: strong
LLM_MODEL=

# Email (Gmail: create an App Password at https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_TO=you@gmail.com

# Optional extra job sources (free tiers)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=
